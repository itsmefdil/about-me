---
---

<div id="ats-modal" class="ats-modal-backdrop hidden no-print">
  <div class="ats-modal-card">
    <div class="modal-header">
      <div class="header-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
        <h3>ATS Keyword Match Simulator</h3>
      </div>
      <button id="close-ats-modal" class="close-btn">&times;</button>
    </div>

    <p class="modal-desc">
      Paste a Job Description (JD) below to simulate how well Fadilah Riczky's CV matches your required keywords and tech stack.
    </p>

    <div class="modal-body">
      <textarea id="jd-input" placeholder="Paste Job Description / Requirements here (e.g. Looking for a DevOps Engineer with Kubernetes, AWS, Terraform, Docker, Python experience)..."></textarea>
      
      <div class="action-row">
        <button id="analyze-btn" class="tool-btn tool-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          Analyze ATS Match
        </button>
      </div>

      <div id="result-box" class="result-box hidden">
        <div class="score-display">
          <div class="score-number" id="score-val">0%</div>
          <div class="score-label" id="score-label">Match Score</div>
        </div>

        <div class="matched-keywords">
          <h4>Matched Tech Keywords:</h4>
          <div id="matched-tags" class="tags-row"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ats-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
    padding: 1rem;
  }
  .hidden {
    display: none !important;
  }
  .ats-modal-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 600px;
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .header-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent-cyan);
  }
  .header-title h3 {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .close-btn {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .modal-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  textarea {
    width: 100%;
    height: 120px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    resize: vertical;
    outline: none;
  }
  textarea:focus {
    border-color: var(--accent-cyan);
  }
  .action-row {
    margin-top: 0.75rem;
    display: flex;
    justify-content: flex-end;
  }
  .result-box {
    margin-top: 1.25rem;
    background: var(--bg-card-hover);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .score-display {
    text-align: center;
  }
  .score-number {
    font-size: 2.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-emerald);
  }
  .score-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .matched-keywords h4 {
    font-size: 0.85rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>

<script>
  const openBtn = document.getElementById('open-ats-modal');
  const closeBtn = document.getElementById('close-ats-modal');
  const modal = document.getElementById('ats-modal');
  const analyzeBtn = document.getElementById('analyze-btn');
  const jdInput = document.getElementById('jd-input') as HTMLTextAreaElement;
  const resultBox = document.getElementById('result-box');
  const scoreVal = document.getElementById('score-val');
  const matchedTags = document.getElementById('matched-tags');

  const knownSkills = [
    'kubernetes', 'docker', 'podman', 'portainer', 'rancher', 'k3s',
    'aws', 'gcp', 'google cloud', 'digitalocean', 'contabo',
    'python', 'bash', 'shell', 'script',
    'terraform', 'helm', 'ansible',
    'jenkins', 'gitlab', 'github actions', 'argocd', 'ci/cd',
    'prometheus', 'grafana', 'dozzle',
    'sonarqube', 'linux', 'devops', 'airflow', 'plesk', 'mysql', 'oracle', 'sql server'
  ];

  openBtn?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
  });

  closeBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });

  analyzeBtn?.addEventListener('click', () => {
    const text = (jdInput?.value || '').toLowerCase();
    if (!text.trim()) return;

    const matched = knownSkills.filter((skill) => text.includes(skill));
    const score = Math.min(100, Math.round((matched.length / Math.max(5, knownSkills.length * 0.3)) * 100));

    if (scoreVal) scoreVal.innerText = `${score}%`;
    if (resultBox) resultBox.classList.remove('hidden');

    if (matchedTags) {
      matchedTags.innerHTML = matched.length > 0
        ? matched.map(m => `<span class="badge">${m.toUpperCase()}</span>`).join(' ')
        : '<span style="font-size: 0.85rem; color: var(--text-primary);">No direct keywords detected. Try adding terms like DevOps, Kubernetes, AWS, Docker, Python.</span>';
    }
  });
</script>
