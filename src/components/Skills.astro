---
import type { Skills } from '../utils/cvLoader';

interface Props {
  skills: Skills;
}

const { skills } = Astro.props;

const categories = [
  { key: 'cloud', label: 'Cloud Infrastructure', items: skills.cloud },
  { key: 'containerization', label: 'Containerization & Orchestration', items: skills.containerization },
  { key: 'ci_cd', label: 'CI/CD & Automation', items: skills.ci_cd },
  { key: 'infrastructure_as_code', label: 'Infrastructure as Code', items: skills.infrastructure_as_code },
  { key: 'programming', label: 'Programming & Scripting', items: skills.programming },
  { key: 'observability', label: 'Observability & Monitoring', items: skills.observability },
  { key: 'security', label: 'Security & Quality', items: skills.security },
  { key: 'languages', label: 'Languages', items: skills.languages },
];
---

<section id="skills" class="section">
  <h2 class="section-title">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    Technical Skills & Expertise
  </h2>

  <ul class="skills-list">
    {categories.map((cat) => (
      cat.items && cat.items.length > 0 && (
        <li class="skill-item">
          <strong class="category-title">{cat.label}:</strong>
          <div class="skill-tags">
            {cat.items.map((item) => (
              <span class="skill-badge">{item}</span>
            ))}
          </div>
        </li>
      )
    ))}
  </ul>
</section>

<style>
  .skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .skill-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .category-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
    min-width: 220px;
    flex-shrink: 0;
  }
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.4rem;
  }
  .skill-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 500;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: none;
    border-radius: 0;
  }

  @media (max-width: 640px) {
    .skill-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }
    .category-title {
      min-width: auto;
    }
  }
</style>
