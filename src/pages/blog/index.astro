---
import Layout from '../../layouts/Layout.astro';
import NavBoxes from '../../components/NavBoxes.astro';
import Toolbar from '../../components/Toolbar.astro';
import { getAllPosts } from '../../utils/blogLoader';

const posts = getAllPosts();
const pageTitle = "Blog & Articles | Fadilah Riczky";
const pageDescription = "Articles and technical notes by Fadilah Riczky on DevOps, Kubernetes, Cloud Infrastructure, and Software Engineering.";
---

<Layout title={pageTitle} description={pageDescription}>
  <NavBoxes slot="top-nav" />

  <header class="blog-header">
    <h1 class="blog-main-title">Blog & Articles</h1>
    <p class="blog-subtitle">Thoughts, notes, and technical write-ups on DevOps, Automation & Cloud.</p>
  </header>

  <div class="blog-list">
    {posts.length > 0 ? (
      posts.map((post) => (
        <article class="blog-card">
          <div class="blog-meta">
            <time class="blog-date">{post.date}</time>
            {post.author && <span class="blog-author">• {post.author}</span>}
          </div>
          <h2 class="blog-title">
            <a href={`/blog/${post.slug}`}>{post.title}</a>
          </h2>
          <p class="blog-desc">{post.description}</p>
          <div class="blog-tags">
            {post.tags.map((tag) => (
              <span class="blog-tag">{tag}</span>
            ))}
          </div>
        </article>
      ))
    ) : (
      <p class="empty-blog">No blog posts found in the blog/ directory.</p>
    )}
  </div>

  <div class="back-home no-print">
    <a href="/" class="back-link">← Back to CV / Portfolio</a>
  </div>

  <footer class="footer no-print">
    <p>© {new Date().getFullYear()} Fadilah Riczky. Built with Astro.</p>
  </footer>

  <Toolbar />
</Layout>

<style>
  .blog-header {
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .blog-main-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .blog-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: 0.35rem;
  }
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .blog-card {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .blog-card:last-child {
    border-bottom: none;
  }
  .blog-meta {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }
  .blog-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .blog-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .blog-title a:hover {
    opacity: 0.75;
  }
  .blog-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .blog-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  .back-home {
    margin-top: 2.5rem;
    padding-top: 1rem;
  }
  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
