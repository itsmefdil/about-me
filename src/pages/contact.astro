---
import Layout from '../layouts/Layout.astro';
import NavBoxes from '../components/NavBoxes.astro';
import Toolbar from '../components/Toolbar.astro';
import { getCvData } from '../utils/cvLoader';

const cvData = getCvData();
const personal = cvData.personal;
const pageTitle = `Contact | ${personal.name} - ${personal.title}`;
const pageDescription = `Get in touch with ${personal.name}, ${personal.title}. Email: ${personal.email}, Phone: ${personal.phone}.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <NavBoxes slot="top-nav" />

  <header class="contact-header">
    <h1 class="contact-main-title">Contact & Get in Touch</h1>
    <p class="contact-subtitle">
      Feel free to reach out for collaborations, DevOps consulting, speaking engagements, or technical inquiries.
    </p>
  </header>

  <div class="contact-grid">
    <!-- Contact Info Cards -->
    <div class="info-column">
      <div class="contact-card">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="0"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </div>
        <div class="card-details">
          <span class="card-label">Email Address</span>
          <a href={`mailto:${personal.email}`} class="card-value-link">{personal.email}</a>
        </div>
      </div>

      <div class="contact-card">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="card-details">
          <span class="card-label">Phone / WhatsApp</span>
          <a href={`tel:${personal.phone.replace(/\s+/g, '')}`} class="card-value-link">{personal.phone}</a>
        </div>
      </div>

      <div class="contact-card">
        <div class="card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="card-details">
          <span class="card-label">Location</span>
          <span class="card-value">{personal.location}</span>
        </div>
      </div>

      <!-- Social Media Profiles -->
      <div class="socials-box">
        <h3 class="socials-head">Social Profiles & Portfolios</h3>
        <div class="social-links">
          {personal.socials.github && (
            <a href={personal.socials.github} target="_blank" rel="noopener noreferrer" class="social-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              GitHub ↗
            </a>
          )}
          {personal.socials.linkedin && (
            <a href={personal.socials.linkedin} target="_blank" rel="noopener noreferrer" class="social-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              LinkedIn ↗
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Interactive Contact Form -->
    <div class="form-column">
      <form class="contact-form" action={`mailto:${personal.email}`} method="post" enctype="text/plain">
        <h3 class="form-head">Send a Direct Message</h3>

        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" placeholder="John Doe" required />
        </div>

        <div class="form-group">
          <label for="email">Your Email</label>
          <input type="email" id="email" name="email" placeholder="john@example.com" required />
        </div>

        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" placeholder="Project Inquiry / Speaking Request" required />
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Hi Fadilah, I would like to discuss..." required></textarea>
        </div>

        <button type="submit" class="submit-btn">Send Message →</button>
      </form>
    </div>
  </div>

  <div class="back-home no-print">
    <a href="/" class="back-link">← Back to CV / Portfolio</a>
  </div>

  <footer class="footer no-print">
    <p>© {new Date().getFullYear()} {personal.name}. Built with Astro.</p>
  </footer>

  <Toolbar />
</Layout>

<style>
  .contact-header {
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .contact-main-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .contact-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: 0.35rem;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .info-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
  }
  .card-icon {
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .card-label {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .card-value {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .card-value-link {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: underline;
  }

  .socials-box {
    margin-top: 1rem;
    padding: 1.2rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
  }
  .socials-head {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
    color: var(--text-primary);
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    font-weight: 600;
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .social-btn:hover {
    border-color: var(--text-primary);
    background: var(--bg-card-hover);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
  }
  .form-head {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-group label {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    font-size: 0.9rem;
    font-family: var(--font-sans);
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    outline: none;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--text-primary);
  }
  .submit-btn {
    padding: 0.75rem 1.2rem;
    font-size: 0.9rem;
    font-family: var(--font-mono);
    font-weight: 700;
    background: var(--text-primary);
    color: var(--bg-primary);
    border: 1px solid var(--text-primary);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .submit-btn:hover {
    opacity: 0.88;
  }

  .back-home {
    margin-top: 2.5rem;
    padding-top: 1rem;
  }
  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
