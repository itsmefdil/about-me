---
import Layout from '../../layouts/Layout.astro';
import NavBoxes from '../../components/NavBoxes.astro';
import Toolbar from '../../components/Toolbar.astro';
import { getAllProjects, getProjectBySlug } from '../../utils/projectsLoader';

export function getStaticPaths() {
  const projects = getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
  throw new Error(`Project not found for slug: ${slug}`);
}

const pageTitle = `${project.title} | Projects - Fadilah Riczky`;
const pageDescription = project.description;
---

<Layout title={pageTitle} description={pageDescription}>
  <NavBoxes slot="top-nav" />

  <article class="project-detail-article">
    <header class="project-header">
      {project.period && <span class="project-period">{project.period}</span>}
      <h1 class="project-title">{project.title}</h1>
      <p class="project-lead">{project.description}</p>

      <div class="tech-stack">
        {project.tech.map((t) => (
          <span class="tech-badge">{t}</span>
        ))}
      </div>

      <div class="project-actions">
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="action-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            View Source Code on GitHub
          </a>
        )}
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="action-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Open Live Application
          </a>
        )}
      </div>
    </header>

    <div class="project-body" set:html={project.contentHtml} />

    <footer class="project-footer no-print">
      <a href="/projects" class="back-link">← Back to All Projects</a>
    </footer>
  </article>

  <Toolbar />
</Layout>

<style>
  .project-detail-article {
    max-width: 100%;
  }
  .project-header {
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .project-period {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }
  .project-title {
    font-size: 2.1rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-primary);
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
  }
  .project-lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .tech-badge {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    font-size: 0.88rem;
    font-family: var(--font-mono);
    font-weight: 600;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .action-btn:hover {
    border-color: var(--text-primary);
    opacity: 0.85;
  }
  .project-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-primary);
  }
  .project-body :global(h1),
  .project-body :global(h2),
  .project-body :global(h3) {
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .project-body :global(h1) { font-size: 1.6rem; }
  .project-body :global(h2) { font-size: 1.35rem; }
  .project-body :global(h3) { font-size: 1.15rem; }
  .project-body :global(p) {
    margin-bottom: 1.25rem;
  }
  .project-body :global(ul),
  .project-body :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .project-body :global(li) {
    margin-bottom: 0.4rem;
  }
  .project-body :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem auto;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    padding: 0.35rem;
  }
  .project-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .project-body :global(th),
  .project-body :global(td) {
    padding: 0.75rem;
    border: 1px solid var(--border-color);
    text-align: center;
    vertical-align: middle;
    background: var(--bg-card);
  }
  .project-body :global(th) {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .project-body :global(td img) {
    max-width: 100%;
    max-height: 400px;
    height: auto;
    object-fit: contain;
    margin: 0.5rem auto;
  }
  .project-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }
  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .back-link:hover {
    text-decoration: underline;
  }
</style>
