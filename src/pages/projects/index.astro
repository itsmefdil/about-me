---
import Layout from '../../layouts/Layout.astro';
import NavBoxes from '../../components/NavBoxes.astro';
import Toolbar from '../../components/Toolbar.astro';
import { getAllProjects } from '../../utils/projectsLoader';

const projects = getAllProjects();
const pageTitle = "Projects & Engineering Works | Fadilah Riczky";
const pageDescription = "Featured projects, DevOps automation templates, Kubernetes setups, and software engineering works by Fadilah Riczky.";
---

<Layout title={pageTitle} description={pageDescription}>
  <NavBoxes slot="top-nav" />

  <header class="projects-header">
    <h1 class="projects-main-title">Projects & Portfolio</h1>
    <p class="projects-subtitle">Infrastructure templates, open-source tools, and DevOps automation projects.</p>
  </header>

  <div class="projects-list">
    {projects.length > 0 ? (
      projects.map((project) => (
        <article class="project-card">
          <div class="card-top">
            <h2 class="project-title">
              <a href={`/projects/${project.slug}`}>{project.title}</a>
            </h2>
            {project.period && <span class="project-period">{project.period}</span>}
          </div>

          <p class="project-desc">{project.description}</p>

          <div class="tech-stack">
            {project.tech.map((t) => (
              <span class="tech-badge">{t}</span>
            ))}
          </div>

          <div class="project-actions">
            {project.githubUrl && (
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="action-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                GitHub Code ↗
              </a>
            )}
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="action-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Live Demo ↗
              </a>
            )}
            <a href={`/projects/${project.slug}`} class="action-btn action-outline">
              Details →
            </a>
          </div>
        </article>
      ))
    ) : (
      <p class="empty-msg">No projects found in content/projects/.</p>
    )}
  </div>

  <div class="back-home no-print">
    <a href="/" class="back-link">← Back to CV / Portfolio</a>
  </div>

  <footer class="footer no-print">
    <p>© {new Date().getFullYear()} Fadilah Riczky. Built with Astro.</p>
  </footer>

  <Toolbar />
</Layout>

<style>
  .projects-header {
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .projects-main-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .projects-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: 0.35rem;
  }
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .project-card {
    padding: 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }
  .project-card:hover {
    border-color: var(--text-primary);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .project-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .project-title a:hover {
    text-decoration: underline;
  }
  .project-period {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }
  .project-desc {
    font-size: 0.93rem;
    color: var(--text-primary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.2rem;
  }
  .tech-badge {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    font-weight: 600;
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .action-btn:hover {
    border-color: var(--text-primary);
    background: var(--bg-card-hover);
  }
  .back-home {
    margin-top: 2.5rem;
    padding-top: 1rem;
  }
  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
